APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=askmydata

# ── JWT Authentication ────────────────────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET_KEY to a long random string in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Google OAuth (required for file uploads to Google Drive) ──────────────────
# Set up credentials at https://console.cloud.google.com/
# Add http://localhost:5173/auth/google/callback as an Authorized redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ── OAuth CSRF State Secret ───────────────────────────────────────────────────
# IMPORTANT: Must be set to a strong random string in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OAUTH_STATE_SECRET=dev-oauth-state-secret

# ── AI / Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_REQUESTS_PER_DAY=100

# ── Upload / Query Limits ─────────────────────────────────────────────────────
MAX_RESULT_ROWS=1000
MAX_QUERY_LENGTH=10000
QUERY_TIMEOUT_SECONDS=30
MAX_UPLOAD_SIZE_MB=25
MAX_CSV_ROWS=200000
MAX_CSV_COLUMNS=200
DATASET_PREVIEW_LIMIT=20
DATASET_UPLOADS_DIR=data/uploads

# ── Login Security ────────────────────────────────────────────────────────────
# Failed password attempts per email/client pair before a 15-minute cooldown
MAX_LOGIN_ATTEMPTS=5

# ── Scheduled Analytics Worker ───────────────────────────────────────────────
AUTOMATION_POLL_SECONDS=15

# ── Developer Webhook Secret Encryption (Phase 22) ───────────────────────────
# Required for encrypting webhook signing secrets at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must be set to a valid Fernet key in production.
WEBHOOK_ENCRYPTION_KEY=

# ── Developer API Rate Limits (Phase 22) ──────────────────────────────────────
# These are controlled by subscription plan (see billing_service.py).
# Free=100/hr, Pro=1000/hr, Team=5000/hr, Enterprise=10000/hr